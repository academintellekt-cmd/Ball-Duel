{
  "name": "ball-duel-attraction",
  "version": "1.0.0",
  "description": "Ball Duel attraction client for StriveX",
  "author": "StriveX",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "check": "eslint . && node --check main.js && node --check preload.js && node --check public/app.js && node --test tests/*.test.js",
    "build": "electron-builder --win nsis"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "37.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  },
  "build": {
    "appId": "local.quest.ballduel",
    "productName": "Ball Duel",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "config.json",
      "public/**/*",
      "lib/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "music",
        "to": "music"
      },
      {
        "from": "installer",
        "to": ".",
        "filter": [
          "*.bat",
          "*.ps1"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "installer/installer.nsh"
    },
    "artifactName": "Ball-Duel-Setup-${version}.${ext}"
  }
}
